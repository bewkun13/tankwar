# Public URL of the deployed Worker, injected as window.TANK_RIVALS_API in production if hosted separately.
TANK_RIVALS_API=https://tank-rivals-api.YOUR_SUBDOMAIN.workers.dev
# Worker configuration (put non-secret values in wrangler.toml; secrets via `wrangler secret put`)
ALLOWED_ORIGIN=https://tank-rivals.pages.dev
MAX_BATCH_SHOTS=300
RATE_WINDOW_SECONDS=30

